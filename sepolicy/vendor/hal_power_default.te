allow hal_power_default proc_walt:dir search;
allow hal_power_default proc_walt:file rw_file_perms;
allow hal_power_default vendor_sysfs_msm_perf:file rw_file_perms;

# ADPF: set uclamp on the threads of hint sessions (apps' RenderThread, SurfaceFlinger, HWC,
# system_server), as hardware/google/pixel-sepolicy/power-libperfmgr does
allow hal_power_default appdomain:process { getsched setsched };
allow hal_power_default self:capability sys_nice;
allow hal_power_default surfaceflinger:process setsched;
allow hal_power_default hal_graphics_composer_default:process setsched;
allow hal_power_default system_server:process setsched;
