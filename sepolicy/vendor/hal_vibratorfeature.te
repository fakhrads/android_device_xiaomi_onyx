type hal_vibratorfeature_default, domain;
type hal_vibratorfeature_default_exec, exec_type, file_type, vendor_file_type;
type hal_vibratorfeature_service, hal_service_type, protected_service, service_manager_type;

binder_use(hal_vibratorfeature_server)
hal_server_domain(hal_vibratorfeature_default, hal_vibratorfeature)
init_daemon_domain(hal_vibratorfeature_default)

allow hal_vibratorfeature_client hal_vibratorfeature_server:binder { call transfer };
allow hal_vibratorfeature_client hal_vibratorfeature_server:fd *;
allow hal_vibratorfeature_client hal_vibratorfeature_service:service_manager find;
allow hal_vibratorfeature_server hal_vibratorfeature_client:binder { call transfer };
allow hal_vibratorfeature_server hal_vibratorfeature_client:fd *;
allow hal_vibratorfeature_server hal_vibratorfeature_service:service_manager { add find };

# qcom-haptics + AW8697/awinic/cs40l26/si_haptic sysfs and char device access,
# matching vendor.xiaomi.hardware.vibratorfeature.service.rc.
allow hal_vibratorfeature_default sysfs:dir { open read search };
allow hal_vibratorfeature_default sysfs:file { getattr open read write };
allow hal_vibratorfeature_default device:chr_file { getattr open read write ioctl };
allow hal_vibratorfeature_default mnt_vendor_file:dir { search };
allow hal_vibratorfeature_default mnt_vendor_file:file { getattr open read write create };
